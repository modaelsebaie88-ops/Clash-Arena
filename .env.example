# ---------------------------------------------------------------------------
# Clash Arena - environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://clasharena:clasharena@localhost:5432/clasharena?schema=public"

# 32+ character secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# How long a login session stays valid.
AUTH_SESSION_TTL_HOURS="72"

# Public origin of the app (used for CORS on the websocket server).
APP_URL="http://localhost:3000"

# HTTP/websocket port for the combined Next.js + Socket.IO server.
PORT="3000"

# Optional. When set, the leaderboard cache and realtime fan-out use Redis so
# the app can run on more than one node. Without it an in-process cache is used.
# REDIS_URL="redis://localhost:6379"

# Where uploaded solution images are written. Keep this OUTSIDE ./public so the
# files are never served directly by the static file handler.
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="8"

# Seed accounts (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@clasharena.dev"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_PARTICIPANT_PASSWORD="Player123!"
